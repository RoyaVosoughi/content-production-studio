# Copy this file to .env.local and fill in what you use. Everything is optional except an AI key and Tavily.
# Restart the studio after changing .env.local. Never commit .env.local: it holds your keys.

# ---- AI ----
# Each team member uses the cheapest model that does its job, and moves to the next one when a free
# allowance runs out: Gemini first, then OpenRouter's free models. The Connections page shows who uses what.

# Recommended. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini model names. Writing (ideas, scenarios, posts) uses the writer model, then the light one;
# checking and teaching use the light one. Defaults: gemini-3.8-flash and gemini-3.5-flash-lite.
GEMINI_WRITER_MODEL=
GEMINI_LIGHT_MODEL=

# Free backup when Gemini's allowance runs out: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: one OpenRouter model, or several separated by commas (tried in order), instead of the default free list
OPENROUTER_MODEL=

# Optional and paid per request. Claude is used only for the jobs listed in CLAUDE_AGENTS.
ANTHROPIC_API_KEY=
# Comma-separated team members that may use Claude: editor (video editing, the default), scout, storyteller,
# telegram, linkedin, carousel, scriptwriter, blogger, manager, coach, setup. Leave empty for none.
CLAUDE_AGENTS=editor

# ---- News search for ideas ---- https://app.tavily.com
TAVILY_API_KEY=

# ---- Database ----
# Leave empty to keep everything in a local database in .data/ (recommended on your own computer).
# Or a Postgres connection string.
DATABASE_URL=

# ---- Telegram ---- bot token from @BotFather, and the channel's number (the Connections page finds it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ---- LinkedIn ---- https://www.linkedin.com/developers/tools/oauth/token-generator (lasts 60 days)
# Without it, LinkedIn posts are copied and posted by hand.
LINKEDIN_ACCESS_TOKEN=

# ---- Instagram ---- a Business or Creator account's token (lasts 60 days). Also needs Supabase below,
# because Instagram fetches slide images from a public address. Without it, slides are downloaded and posted by hand.
INSTAGRAM_ACCESS_TOKEN=

# ---- Supabase ---- for Instagram images, and for posting articles to a Supabase blog table.
# Project URL, and a secret key (Settings > API Keys). The key can change your whole database: keep it here only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---- Website blog: choose one ----
# A) Webhook: each article is sent as JSON to this address (WordPress, Ghost, n8n, Zapier, Make, your own site).
#    See "Posting to your website" in README.md. The secret is sent as "Authorization: Bearer <secret>".
WEBSITE_WEBHOOK_URL=
WEBSITE_WEBHOOK_SECRET=
# B) Supabase: each article becomes a row in this table (uses SUPABASE_URL and SUPABASE_SECRET_KEY above).
WEBSITE_SUPABASE_TABLE=blog_posts

# ---- Video and slides (optional) ----
# FFmpeg and Chrome are found automatically when installed. Set these only if they aren't.
FFMPEG_PATH=
FFPROBE_PATH=
CHROME_PATH=
